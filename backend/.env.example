# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_pg

# Set to true for cloud MySQL providers requiring SSL/TLS (such as TiDB Cloud)
DB_SSL=false

# Optional: Full Database URL override (e.g. mysql+pymysql://user:pass@host:4000/db?ssl_verify_cert=true)
# DATABASE_URL=

# Application Secret Key for JWT
SECRET_KEY=change-this-secret-key-in-production

# CORS Allowed Origins (comma-separated if multiple, or set FRONTEND_URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=
